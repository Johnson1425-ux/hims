# =============================================================================
# HIMS environment. Copy to .env and fill in. NEVER commit the real file.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# ---- API -------------------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ---- Which PostgreSQL ------------------------------------------------------
# Two options. Pick one and make all the DATABASE_* URLs below agree.
#
#  A. YOUR OWN PostgreSQL (15 or later), already installed. Nothing to run,
#     nothing in Docker. Delete POSTGRES_PORT, use port 5432, and put your own
#     superuser password in DATABASE_ADMIN_URL:
#
#       DATABASE_ADMIN_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres
#       DATABASE_URL=postgresql://hims_app:dev-only-password@localhost:5432/hims
#       DATABASE_MIGRATION_URL=postgresql://hims_owner:dev-only-password@localhost:5432/hims
#
#     `pnpm db:create` then creates the hims database and its four roles inside
#     your server. It touches nothing else in it.
#
#  B. The bundled container: `docker compose -f infra/docker-compose.yml up -d`.
#     POSTGRES_PORT is the HOST port it is published on, read by docker compose
#     and not by the application. It defaults to 5433 rather than 5432 on
#     purpose: a locally installed PostgreSQL usually already holds 5432 — on
#     Windows and macOS the installer registers a service that starts at boot —
#     and the collision does not announce itself, because clients reach the
#     wrong server and the error blames the password.
#
# Option B is the default below. POSTGRES_PORT and the three DATABASE_* URLs
# must agree; `pnpm db:create` says so before connecting if they do not, and
# finishes by proving each URL can actually log in.
POSTGRES_PORT=5433

# Reserved, and read by nothing today — the API has no Redis client and does
# not connect to one. Caching and the notification queue are the intended
# users; until then the bundled redis container is optional. Nothing but
# PostgreSQL has to be running.
REDIS_PORT=6379

# ---- Local database bootstrap ----------------------------------------------
# Used ONLY by `pnpm db:create`, which connects as the bootstrap superuser to
# create the hims database and its four roles. Not read at runtime.
#
# DATABASE_DEV_PASSWORD is the password db:create ASSIGNS to the roles it
# creates. The passwords inside DATABASE_URL and DATABASE_MIGRATION_URL are
# what the API and the migration runner PRESENT. Nothing keeps them equal, so
# change all three together — db:create warns if they disagree, resets the
# roles from this value on every local run, and then proves the URLs work
# before reporting success. Use a secret manager in production.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/postgres
DATABASE_NAME=hims
DATABASE_DEV_PASSWORD=dev-only-password

# ---- Database --------------------------------------------------------------
# The API connects as a role WITHOUT bypassrls, so row-level security applies.
DATABASE_URL=postgresql://hims_app:dev-only-password@localhost:5433/hims
# Separate URL for migrations: needs table ownership, so it is a different role.
DATABASE_MIGRATION_URL=postgresql://hims_owner:dev-only-password@localhost:5433/hims

# ---- The platform console (OPTIONAL, and off by default) -------------------
# The vendor-side console at /api/v1/platform: provisioning hospitals,
# suspending them, managing operators, reading the audit trail across tenants.
#
# It is the ONE surface in this system that crosses tenant boundaries, so it
# is not mounted at all unless BOTH of the variables below are set. An
# installation that has not deliberately asked for cross-tenant access gets a
# 404 there rather than a login prompt in front of a privileged endpoint.
#
# hims_platform is the BYPASSRLS role `pnpm db:create` already makes. It is
# also what `pnpm db:verify` needs in order to check the audit hash chain —
# the migration role cannot see audit_events through row-level security, and
# without this the check is reported as NOT CHECKED rather than passing.
#
# Generate the secret: openssl rand -base64 48
# It MUST differ from the two JWT secrets below. With a separate key, a
# hospital access token cannot be verified as a console token even if an
# audience check were one day forgotten.
#
# Create the first operator once both are set:
#   pnpm platform:bootstrap -- --email ops@example.com --name "Your Name"
#
# DATABASE_PLATFORM_URL=postgresql://hims_platform:dev-only-password@localhost:5433/hims
# JWT_PLATFORM_SECRET=replace-with-a-third-long-random-secret
DATABASE_POOL_MAX=20
DATABASE_SSL=false
# Hard ceiling on any single query. Stops one pathological report pinning a
# connection and starving the clinical path.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---- Encryption ------------------------------------------------------------
# Master key wrapping each tenant's data key (envelope encryption).
# Generate: openssl rand -base64 32
# In production this lives in AWS KMS / GCP KMS / Vault, not in an env var.
MASTER_KEY=replace-with-32-byte-base64-key
MASTER_KEY_VERSION=1
# Separate key for HMAC blind indexes. MUST differ from MASTER_KEY: reusing one
# key for both encryption and indexing weakens both.
BLIND_INDEX_KEY=replace-with-32-byte-base64-key

# ---- JWT -------------------------------------------------------------------
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ISSUER=hims.local
# Short access tokens; permission changes then take effect within one TTL.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# HIPAA §164.312(a)(2)(iii) automatic logoff, in minutes.
SESSION_IDLE_TIMEOUT_MINUTES=15

# ---- Account protection ----------------------------------------------------
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=12

# ---- Object storage (documents, scans, signatures) -------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hims-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# MinIO is no longer on Docker Hub; the compose file pulls from quay.io.
# Override to pin a dated RELEASE tag, or to use a different S3 server.
MINIO_IMAGE=quay.io/minio/minio:latest

# ---- Notifications ---------------------------------------------------------
# Leave the provider unset in development: the worker then logs instead of
# sending, so no test reminder ever reaches a real patient.
# Leave MAIL_PROVIDER empty and email is rendered and logged but not sent,
# which is the right default for development. Set it to "smtp" and the worker
# delivers through any SMTP relay — SES, Mailgun, Postmark, Resend, a
# hospital's own Exchange server, or a local capture sink. There is no vendor
# SDK, so switching provider is four lines of .env and no deploy of new code.
#
#   SES        email-smtp.<region>.amazonaws.com : 587, SMTP credentials
#              generated in the SES console (NOT your AWS access keys)
#   Mailgun    smtp.mailgun.org : 587
#   Postmark   smtp.postmarkapp.com : 587, server token as both user and pass
#   Resend     smtp.resend.com : 587, user "resend", password an API key
#   Local      see SMTP_INSECURE below
#
# PORT DECIDES THE ENCRYPTION, and there is nothing else to set: 465 is
# implicit TLS, 587 and 2525 are STARTTLS, which this code REQUIRES rather
# than merely attempting. A relay that does not offer STARTTLS is refused
# instead of being sent to in the clear.
#
# MAIL_FROM must be an address the provider has authorised you to send from,
# or everything will be rejected with a 5xx. It is also what recipients see,
# so use a real domain, not the default below.
MAIL_PROVIDER=
MAIL_FROM=no-reply@hims.local
# Where a reply goes. Several messages — payment receipts, invoice corrections
# — end "reply to this message and we will look into it", so either set this
# to a mailbox somebody reads or make MAIL_FROM one.
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Drops the STARTTLS requirement. ONLY for a local capture sink that speaks
# plain SMTP — MailHog, Mailpit, maildev — where there is no TLS to require.
# The API refuses to boot with this set in production.
SMTP_INSECURE=false

SMS_PROVIDER=
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Subscription invoices -------------------------------------------------
# Printed on the PDF the hospital receives. Defaults are obvious placeholders
# so an unconfigured deployment cannot send something mistakable for a bill.
#
# Use \n for line breaks: dotenv takes only the FIRST line of an unquoted
# multi-line value and silently drops the rest, which is how a three-line
# postal address ends up on an invoice as one line.
INVOICE_VENDOR_NAME=Your Company Ltd
INVOICE_VENDOR_ADDRESS=Street address\nCity, Country\nTIN 000-000-000
# Bank or mobile-money details. Omitted from the PDF entirely when unset, and
# always omitted from an invoice that is already paid or voided.
INVOICE_PAYMENT_DETAILS=Bank Name · Account Name · 0000-000000-00\nMobile money till 00 00 00

# ---- Jobs ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REMINDER_SCAN_INTERVAL_SECONDS=60
# Hours before an appointment to send each reminder.
REMINDER_OFFSETS_HOURS=48,24,2
